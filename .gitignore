# --- Dependencies ---------------------------------------------------------
node_modules/

# --- Secrets / environment ------------------------------------------------
# Real keys live in .env; only the template (.env.example) is committed.
.env
.env.*
!.env.example

# SSH private keys (e.g. Azure VM access) must never be committed.
*.pem
*.ppk
shruti_key*

# yt-dlp cookies — a live YouTube session credential.
cookies.txt

# --- Build output ---------------------------------------------------------
dist/
build/

# --- Runtime cache (downloaded videos, extracted frames, timelines) -------
.cache/

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor junk -----------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/

# --- Test coverage / scratch ----------------------------------------------
coverage/
.nyc_output/
*.tmp

# --- Claude Code local overrides ------------------------------------------
.claude/settings.local.json

# --- Private prep (not part of the deliverable) ---------------------------
DEMO_SCRIPT.md

.claude

